# Maintainer: UniNote Developers <uninote@uninote.org>
pkgname=uninote
pkgver=0.4.11
pkgrel=1
pkgdesc="Suite accademica Linux nativa per prendere appunti a mano libera con stilo (MPP, Wacom)"
arch=('x86_64')
url="https://github.com/Loreexe/UniNote"
license=('GPL-3.0-only')
depends=(
    'gtk4'
    'libadwaita'
    'poppler-glib'
    'cairo'
    'hicolor-icon-theme'
    'shared-mime-info'
)
makedepends=(
    'cargo'
    'git'
)
provides=('uninote')
conflicts=('uninote-git')
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('b1f798db33a3b5abc4ae8239f4f0051d93764e25abfbb4aae94d133d97b4e63b')

prepare() {
    cd "UniNote-$pkgver" 2>/dev/null || cd "$pkgname-$pkgver" 2>/dev/null || cd "$pkgname"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "UniNote-$pkgver" 2>/dev/null || cd "$pkgname-$pkgver" 2>/dev/null || cd "$pkgname"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    # Disabilita LDFLAGS aggressivi di makepkg che interferiscono con l'archivio statico di sqlite3 bundled
    unset LDFLAGS
    cargo build --frozen --release -p uninote-app
}

check() {
    cd "UniNote-$pkgver" 2>/dev/null || cd "$pkgname-$pkgver" 2>/dev/null || cd "$pkgname"
    # La wiki privata .uninote-wiki/ è esclusa dal repository pubblico (RULES §2.3), quindi
    # il test di governance sulla sua freschezza non è verificabile sul tarball distribuito.
    cargo test --frozen --workspace -- --skip test_t1_25_wiki_freshness_and_governance_contract
}

package() {
    cd "UniNote-$pkgver" 2>/dev/null || cd "$pkgname-$pkgver" 2>/dev/null || cd "$pkgname"

    # Binario eseguibile principale
    install -Dm755 "target/release/uninote" "$pkgdir/usr/bin/uninote"

    # File Desktop FreeDesktop
    install -Dm644 "data/org.uninote.UniNote.desktop" "$pkgdir/usr/share/applications/org.uninote.UniNote.desktop"

    # Metadati AppStream 1.0
    install -Dm644 "data/org.uninote.UniNote.metainfo.xml" "$pkgdir/usr/share/metainfo/org.uninote.UniNote.metainfo.xml"

    # Definizione MIME Type per file .uninote
    install -Dm644 "data/org.uninote.UniNote.xml" "$pkgdir/usr/share/mime/packages/org.uninote.UniNote.xml"

    # Icone SVG vettoriali
    install -Dm644 "data/icons/hicolor/scalable/apps/org.uninote.UniNote.svg" \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/org.uninote.UniNote.svg"
    install -Dm644 "data/icons/hicolor/symbolic/apps/org.uninote.UniNote-symbolic.svg" \
        "$pkgdir/usr/share/icons/hicolor/symbolic/apps/org.uninote.UniNote-symbolic.svg"
    install -Dm644 "data/icons/hicolor/scalable/mimetypes/application-x-uninote.svg" \
        "$pkgdir/usr/share/icons/hicolor/scalable/mimetypes/application-x-uninote.svg"

    # Icone raster PNG hicolor
    for res in 16 32 48 64 128 256 512; do
        if [ -f "data/icons/hicolor/${res}x${res}/apps/org.uninote.UniNote.png" ]; then
            install -Dm644 "data/icons/hicolor/${res}x${res}/apps/org.uninote.UniNote.png" \
                "$pkgdir/usr/share/icons/hicolor/${res}x${res}/apps/org.uninote.UniNote.png"
        fi
    done

    # Icone MIME raster
    for res in 48 128; do
        if [ -f "data/icons/hicolor/${res}x${res}/mimetypes/application-x-uninote.png" ]; then
            install -Dm644 "data/icons/hicolor/${res}x${res}/mimetypes/application-x-uninote.png" \
                "$pkgdir/usr/share/icons/hicolor/${res}x${res}/mimetypes/application-x-uninote.png"
        fi
    done

    # Testo della licenza GPL-3.0
    install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
